<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <config>
    <!-- A folder of its own, so that a package with the version of a published one isn't taken from the global cache -->
    <add key="globalPackagesFolder" value="../../.artifacts/smoke/packages" />
  </config>
  <packageSources>
    <clear />
    <add key="artifacts" value="../../.artifacts" />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" />
  </packageSources>
  <packageSourceMapping>
    <packageSource key="artifacts">
      <package pattern="Wcwidth.Sources" />
    </packageSource>
    <packageSource key="nuget.org">
      <package pattern="*" />
    </packageSource>
  </packageSourceMapping>
</configuration>
